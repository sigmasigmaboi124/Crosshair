<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZeroPointOverlay</AssemblyName>
    <ApplicationIcon>..\..\build\icon.ico</ApplicationIcon>
    <AssemblyTitle>ZeroPoint Crosshair Overlay</AssemblyTitle>
    <Product>ZeroPoint Crosshair Overlay</Product>
    <Description>ZeroPoint Crosshair Overlay</Description>
    <Company>ZeroPoint</Company>
    <Version>1.3.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>
</Project>
